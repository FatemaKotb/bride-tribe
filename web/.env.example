# Copy this file to .env.local and fill in the values.
#
# Local Supabase: run `npx supabase status -o env` in the repository root
# and copy API_URL and ANON_KEY. To try the app on a phone on the same
# Wi-Fi, use this computer's network address instead of 127.0.0.1, for
# example http://192.168.1.20:54321.
#
# Hosted Supabase: Project Settings > API. Only the anon (public) key goes
# here. Never put the service role key in this file or anywhere in the repo.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

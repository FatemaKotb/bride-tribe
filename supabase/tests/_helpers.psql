-- Shared pgTAP helpers. Every test file includes this (\ir _helpers.psql)
-- right after `begin`, so everything here is rolled back with the test.
-- The .psql extension keeps `supabase test db` from running it as a test.

set client_min_messages = warning;
create extension if not exists pgtap with schema extensions;

create schema tests;

-- ---------------------------------------------------------------------
-- Members
-- ---------------------------------------------------------------------

-- Replaces the seeded members with a fixed cast, so tests don't depend
-- on seed.sql. Call it before creating any other fixtures.
create function tests.reset_members() returns void
language sql as $$
  delete from member;
  insert into member (name, role) values
    ('Bride', 'bride'),
    ('Mai',   'maid_of_honor'),
    ('Sara',  'bridesmaid'),
    ('Nour',  'bridesmaid');
$$;

create function tests.member_id(member_name text) returns uuid
language sql stable as $$
  select id from member where name = member_name;
$$;

-- ---------------------------------------------------------------------
-- Sessions: who "me" is
-- ---------------------------------------------------------------------

-- Test sessions by label (a phone, or a member's name for act_as).
create table tests.session (
  label        text primary key,
  auth_user_id uuid not null
);

-- Makes an existing session the caller by setting the JWT claims.
create function tests.use_session(session_label text) returns uuid
language plpgsql as $$
declare
  uid uuid;
begin
  select auth_user_id into uid from tests.session where label = session_label;
  if not found then
    raise exception 'unknown test session: %', session_label;
  end if;
  perform set_config('request.jwt.claims',
    json_build_object('sub', uid, 'role', 'authenticated')::text, true);
  return uid;
end;
$$;

-- Starts a Supabase anonymous session that isn't linked to a member yet
-- (as after signInAnonymously), and makes it the caller.
create function tests.new_session(session_label text) returns uuid
language plpgsql as $$
declare
  uid uuid := gen_random_uuid();
begin
  insert into auth.users (id, aud, role, is_anonymous)
  values (uid, 'authenticated', 'authenticated', true);
  insert into tests.session (label, auth_user_id) values (session_label, uid);
  return tests.use_session(session_label);
end;
$$;

-- Acts as a member. The first call creates their session and links it
-- in member_session; later calls switch back to it.
create function tests.act_as(member_name text) returns uuid
language plpgsql as $$
declare
  uid uuid;
begin
  if exists (select 1 from tests.session where label = member_name) then
    return tests.use_session(member_name);
  end if;
  uid := tests.new_session(member_name);
  insert into member_session (auth_user_id, member_id)
  values (uid, tests.member_id(member_name));
  return uid;
end;
$$;

-- No Supabase session at all.
create function tests.no_session() returns void
language sql as $$
  select set_config('request.jwt.claims', '', true);
$$;

-- ---------------------------------------------------------------------
-- Items, cars, and requests
-- ---------------------------------------------------------------------

-- The id of the one item with this name (and owner, when names repeat,
-- as with copies). Fails loudly when there isn't exactly one.
create function tests.item_id(item_name text, owner_name text default null) returns uuid
language plpgsql stable as $$
declare
  found_id uuid;
begin
  select id into strict found_id from item
  where name = item_name
    and (owner_name is null or owner_id = tests.member_id(owner_name));
  return found_id;
end;
$$;

-- An item's stored fields, with member and bag names instead of ids.
create function tests.item_fields(target_id uuid) returns jsonb
language sql stable as $$
  select jsonb_build_object(
    'kind',        i.kind,
    'owner',       (select name from member where id = i.owner_id),
    'name',        i.name,
    'emoji',       i.emoji,
    'description', i.description,
    'quantity',    i.quantity,
    'visibility',  i.visibility,
    'type',        i.type,
    'claimed_by',  (select name from member where id = i.claimed_by_id),
    'in',          (select name from item bag where bag.id = i.parent_id),
    'packed',      i.is_packed)
  from item i where i.id = target_id;
$$;

create function tests.vendor_fields(target_id uuid) returns jsonb
language sql stable as $$
  select jsonb_build_object(
    'vendor_name',   vendor_name,
    'service',       service,
    'phone',         phone,
    'address',       address,
    'expected_time', expected_time,
    'amount_egp',    amount_egp,
    'details',       details)
  from vendor_details where item_id = target_id;
$$;

-- A car inserted directly, with valid defaults for its trip.
create function tests.add_car(owner_name text, car_trip trip default 'to_hotel') returns uuid
language sql as $$
  insert into car (owner_id, trip, seats, departure_earliest, departure_latest,
                   home_area, trunk_percent)
  values (tests.member_id(owner_name), car_trip, 3, '09:00', '10:00',
          case when car_trip = 'to_hotel' then 'maadi'::area end, 50)
  returning id;
$$;

-- The member's active (not withdrawn) car on a trip.
create function tests.car_id(owner_name text, car_trip trip default 'to_hotel') returns uuid
language plpgsql stable as $$
declare
  found_id uuid;
begin
  select id into strict found_id from car
  where owner_id = tests.member_id(owner_name) and trip = car_trip and withdrawn_at is null;
  return found_id;
end;
$$;

-- A car's stored fields, with its stops and drop-off areas.
create function tests.car_fields(target_id uuid) returns jsonb
language sql stable as $$
  select jsonb_build_object(
    'owner',              (select name from member where id = c.owner_id),
    'trip',               c.trip,
    'seats',              c.seats,
    'departure_earliest', c.departure_earliest,
    'departure_latest',   c.departure_latest,
    'home_area',          c.home_area,
    'home_area_other',    c.home_area_other,
    'minutes_to_bride',   c.minutes_to_bride,
    'minutes_to_hotel',   c.minutes_to_hotel,
    'trunk_percent',      c.trunk_percent,
    'notes',              c.notes,
    'withdrawn',          c.withdrawn_at is not null,
    'stops', (select coalesce(jsonb_agg(jsonb_build_object(
                'description', s.description, 'purpose', s.purpose) order by s.position), '[]')
              from car_stop s where s.car_id = c.id),
    'dropoff', (select coalesce(jsonb_agg(jsonb_build_object(
                  'area', d.area, 'area_other', d.area_other) order by d.area), '[]')
                from car_dropoff_area d where d.car_id = c.id))
  from car c where c.id = target_id;
$$;

-- A passenger Ask inserted directly, sent by the passenger.
create function tests.add_passenger_request(
  target_car_id uuid, passenger_name text, request_state request_state default 'pending'
) returns uuid
language sql as $$
  insert into request (car_id, trip, direction, kind, created_by_id, passenger_id,
                       state, cancel_reason)
  select c.id, c.trip, 'ask', 'passenger', tests.member_id(passenger_name),
         tests.member_id(passenger_name), request_state,
         case when request_state = 'cancelled' then 'by_sender'::cancel_reason end
  from car c where c.id = target_car_id
  returning id;
$$;

-- A cargo Ask inserted directly, sent by the cargo's owner.
create function tests.add_cargo_request(
  target_car_id uuid, target_item_id uuid, request_state request_state default 'pending'
) returns uuid
language sql as $$
  insert into request (car_id, trip, direction, kind, created_by_id, item_id,
                       state, cancel_reason, pickup_type)
  select c.id, c.trip, 'ask', 'cargo', coalesce(i.claimed_by_id, i.owner_id), i.id,
         request_state,
         case when request_state = 'cancelled' then 'by_sender'::cancel_reason end,
         'bride_home'
  from car c, item i
  where c.id = target_car_id and i.id = target_item_id
  returning id;
$$;

-- The one request on this car about this passenger or item (by name),
-- optionally in a given state.
create function tests.request_on(
  target_car_id uuid, subject_name text, in_state request_state default null
) returns uuid
language plpgsql stable as $$
declare
  found_id uuid;
begin
  select r.id into strict found_id
  from request r
  left join member p on p.id = r.passenger_id
  left join item i on i.id = r.item_id
  where r.car_id = target_car_id
    and coalesce(p.name, i.name) = subject_name
    and (in_state is null or r.state = in_state);
  return found_id;
end;
$$;

-- A request's stored fields, with names instead of ids.
create function tests.request_fields(request_id uuid) returns jsonb
language sql stable as $$
  select jsonb_build_object(
    'car',            (select m.name from car c join member m on m.id = c.owner_id where c.id = r.car_id),
    'trip',           r.trip,
    'direction',      r.direction,
    'kind',           r.kind,
    'sent_by',        (select name from member where id = r.created_by_id),
    'passenger',      (select name from member where id = r.passenger_id),
    'item',           (select name from item where id = r.item_id),
    'state',          r.state,
    'cancel_reason',  r.cancel_reason,
    'pickup_type',    r.pickup_type,
    'pickup_address', r.pickup_address,
    'ready_at',       r.ready_at)
  from request r where r.id = request_id;
$$;

-- "state/reason", for example "cancelled/auto", or null once deleted.
create function tests.request_state(request_id uuid) returns text
language sql stable as $$
  select state::text || coalesce('/' || cancel_reason::text, '') from request where id = request_id;
$$;

-- ---------------------------------------------------------------------
-- Assertions
-- ---------------------------------------------------------------------

-- Passes when `sql` raises the contract error `code` (the hint) with the
-- user-facing `message`. The failed statement's changes are rolled back.
create function tests.throws_error(sql text, code text, message text, description text)
returns text
language plpgsql as $$
declare
  got_code    text;
  got_message text;
begin
  begin
    execute sql;
  exception when others then
    get stacked diagnostics got_code = pg_exception_hint, got_message = message_text;
    return is(
      coalesce(nullif(got_code, ''), '<no hint>') || ': ' || got_message,
      code || ': ' || message,
      description);
  end;
  return ok(false, description) || e'\n' || diag('    no error was raised');
end;
$$;
